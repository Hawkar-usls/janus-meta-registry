{
  "schema": "janus.eye.hrain_inaihr.interhemisphere_contract.v1",
  "artifact_id": "JANUS-EYE-HRAIN-INAIHR-INTERHEMISPHERE-CONTRACT-v1.0",
  "date": "2026-09-01",
  "status": "CANONICAL_INTERHEMISPHERE_ATTENTION_BRIDGE",
  "purpose": "Bind EYE to the JANUS bicameral context system so HRAiN grounds structural context, EYE extracts representation-aware bridges, iNaiHR returns associative context through HRAiN mediation, and independent verification retains terminal authority.",
  "canonical_formula": "HRAIN_GROUNDS -> EYE_BRIDGES -> INAIHR_ASSOCIATES -> HRAIN_MEDIATES -> VERIFY_DECIDES",
  "organ_roles": {
    "HRAiN": {
      "hemisphere": "LEFT_HRAIN",
      "role": "STRUCTURAL_CONTEXT_GROUNDING_MEDIATOR",
      "may": [
        "validate source/provenance structure",
        "expand EYE structural queries",
        "carry EYE association requests to iNaiHR",
        "mediate iNaiHR associative responses back toward EYE"
      ],
      "may_not": [
        "promote contextual association to truth",
        "treat derivative HRAiN memory exports as fresh source evidence",
        "grant EYE or iNaiHR mutation authority"
      ]
    },
    "EYE": {
      "role": "INTER_HEMISPHERE_CONTEXT_BRIDGE",
      "may": [
        "declare target invariant and representation contract",
        "extract bridge invariants",
        "request structural expansion from HRAiN",
        "request associative context from iNaiHR through HRAiN",
        "maintain MATCH/MISMATCH/OPEN boundaries"
      ],
      "may_not": [
        "bypass HRAiN to iNaiHR",
        "claim SHA256 inversion",
        "upgrade semantic region to exact recovery without verification",
        "write truth into either hemisphere"
      ]
    },
    "iNaiHR": {
      "hemisphere": "RIGHT_INAIHR",
      "role": "ASSOCIATIVE_CONTEXT",
      "may": [
        "associate grounded context",
        "return semantic regions",
        "return ambiguity sets",
        "return contradictions and associative bridge support"
      ],
      "may_not": [
        "accept direct EYE packets",
        "claim independent replication from bicameral agreement",
        "promote associations to evidence",
        "return authoritative proof/truth/execution directives"
      ]
    },
    "VERIFY": {
      "role": "TERMINAL_ASSERTION_GATE",
      "terminal_authority": true,
      "rule": "A control must have power to say NO. Exact candidates require an appropriate frozen verifier; otherwise the result remains SEMANTIC_REGION_SUPPORTED, AMBIGUOUS, OPEN, or BLOCKED."
    }
  },
  "channels": {
    "EYE_TO_HRAIN": {
      "meaning": "STRUCTURAL_QUERY_EXPANSION_ONLY",
      "source": "EYE",
      "target": "LEFT_HRAIN",
      "authority_delta": 0
    },
    "HRAIN_TO_EYE_GROUNDED_CONTEXT": {
      "meaning": "READ_ONLY_STRUCTURAL_GROUNDING",
      "source": "LEFT_HRAIN",
      "target": "EYE",
      "grounding_states": ["MATCH", "MISMATCH", "OPEN"],
      "truth_authority": false
    },
    "EYE_TO_INAIHR_VIA_HRAIN": {
      "meaning": "SEMANTIC_ASSOCIATION_INPUT_ONLY",
      "physical_source": "LEFT_HRAIN",
      "logical_source": "EYE",
      "target": "RIGHT_INAIHR",
      "via": "LEFT_HRAIN",
      "direct_bypass": "FORBIDDEN"
    },
    "INAIHR_TO_EYE_VIA_HRAIN": {
      "meaning": "ASSOCIATIVE_CONTEXT_ONLY",
      "source": "RIGHT_INAIHR",
      "target": "EYE",
      "via": "LEFT_HRAIN",
      "evidence_authority": false,
      "independent_replication": false,
      "terminal_authority": false
    }
  },
  "implementation_bindings": {
    "HRAiN": {
      "repository": "Hawkar-usls/Hrain",
