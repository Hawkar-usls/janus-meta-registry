    "EYE_root": "EYE/EYE-ROOT-CONSTITUTION-v1.0.json"
  },
  "self_training_firewall": {
    "forbidden_as_fresh_EYE_source": [
      "assets/hrain-full-memory/",
      "assets/hrain-registry-index.json",
      "EYE/generated/"
    ],
    "law": "DERIVATIVE_MEMORY_EXPORT != FRESH_WORLD_EVIDENCE",
    "reason": "Prevent memory-of-memory recursion, feedback amplification, and false evidence multiplication."
  },
  "packet_firewall": {
    "required": {
      "read_only_transfer": true,
      "direct_mutation": false,
      "authority_delta": 0,
      "claim_promotion": false,
      "proof_authority": false,
      "external_effect_authority": false
    },
    "integrity": "Every bridge packet is deterministically canonicalized and SHA-256 sealed; tampering must fail closed.",
    "direct_eye_to_inaihr": "REJECT",
    "authoritative_association_keys": "REJECT"
  },
  "representation_contract": {
    "mandatory_question": "В КАКОМ ПРЕДСТАВЛЕНИИ И ОТНОСИТЕЛЬНО КАКОГО ИНВАРИАНТА?",
    "required_fields": [
      "target_invariant",
      "must_preserve",
      "metric_or_bridge_rule",
      "reference_frame",
      "positive_control",
      "negative_control_or_falsifier",
      "provenance"
    ],
    "law": "MEANINGFUL_DIFFERENCE_REQUIRES_A_REPRESENTATION_THAT_PRESERVES_THE_RELEVANT_INVARIANT"
  },
  "verdict_space": [
    "EXACT_MATCH",
    "EXACT_MISMATCH",
    "SEMANTIC_REGION_SUPPORTED",
    "AMBIGUOUS",
    "OPEN",
    "BLOCKED"
  ],
  "epistemic_firewalls": [
    "HRAIN_GROUNDING != TRUTH",
    "EYE_BRIDGE != PROOF",
    "INAIHR_ASSOCIATION != EVIDENCE",
    "BICAMERAL_AGREEMENT != INDEPENDENT_REPLICATION",
    "SEMANTIC_REGION != EXACT_PLAINTEXT",
    "ATTENTION != EVIDENCE",
    "UNKNOWN != NEGATIVE",
    "RESOURCE_LIMIT != TARGET_NEGATIVE",
    "REPLAY != NEW_EVIDENCE",
    "DIRECT_EYE_TO_INAIHR_BYPASS_FORBIDDEN",
    "CONTROL_MUST_HAVE_POWER_TO_SAY_NO"
  ],
  "seal": "HRAiN GROUNDS. EYE BRIDGES. iNaiHR ASSOCIATES. HRAiN MEDIATES. VERIFICATION DECIDES WHAT MAY BE SAID."
