      "module_commit": "e837b38c55ec9e8dde3c578c84d3473878452d4c",
      "test": "tools/test-eye-interhemisphere-bridge.js",
      "test_commit": "8b283f0835f0d60be9adeead1134e0d89cdb4ecf",
      "link": ".janus/EYE_INTERHEMISPHERE_LINK.json",
