      {"id":"end_to_end_rebuild","cost":6,"calibrated":true,"failure_domains":["rebuild"],"likelihood_by_cause":{
        "stale_or_derivative_result":{"VALID":0.01,"INVALID":0.99},"valid_independent_result":{"VALID":0.995,"INVALID":0.005},"verifier_specific_false_positive":{"VALID":0.02,"INVALID":0.98}}}
