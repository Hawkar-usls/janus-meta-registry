      "independent_verifier":{"stale_or_derivative_result":{"MATCH":0.4,"REJECT":0.6},"valid_independent_result":{"MATCH":0.65,"REJECT":0.35},"verifier_specific_false_positive":{"MATCH":0.45,"REJECT":0.55}}
    }}
  ]}
