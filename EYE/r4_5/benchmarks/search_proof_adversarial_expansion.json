        "independent_verifier":{"stale_or_derivative_result":{"MATCH":0.1,"REJECT":0.9},"valid_independent_result":{"MATCH":0.95,"REJECT":0.05},"verifier_specific_false_positive":{"MATCH":0.2,"REJECT":0.8}}
      }}
    ]
  },
  "uncertainty_envelope":{"type":"DECLARED_FINITE_VERTEX_SET","vertex_models":[
    {"id":"joint_audit_verifier_breaker","weight":1,"provenance":"synthetic admissible vertex jointly degrading provenance and verifier while leaving rebuild calibrated","likelihood_overrides":{
