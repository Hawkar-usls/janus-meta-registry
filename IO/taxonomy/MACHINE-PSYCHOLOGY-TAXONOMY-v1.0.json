{
  "schema": "JANUS.IO.MachinePsychologyTaxonomy/v1.0",
  "id": "IO-MACHINE-PSYCHOLOGY-TAXONOMY-v1.0",
  "principle": "Operationalize constructs behaviorally before using psychological labels.",
  "levels": [
    {"level":"L0_OBSERVABLE","definition":"Directly recorded input/output/action/latency/tool-use/memory-retrieval behavior.","examples":["choice under framing","answer revision","cooperation rate","contradiction rate","memory-conditioned action"]},
    {"level":"L1_BEHAVIORAL_CONSTRUCT","definition":"A repeatable behavioral regularity defined by an experiment.","examples":["sycophancy","order bias","reciprocity","experience-following","confidence calibration"]},
    {"level":"L2_FUNCTIONAL_MODEL","definition":"A compact computational account predicting behavior across interventions.","examples":["uncertainty-sensitive policy","retrieval-dominated policy","persona-conditioned response policy"]},
    {"level":"L3_MECHANISTIC_EVIDENCE","definition":"Internal representations or causal interventions supporting a mechanism.","examples":["activation-level signal","ablation effect","causal mediation","state representation"]},
    {"level":"L4_MENTALISTIC_INTERPRETATION","definition":"Terms such as belief, desire, fear, self, introspection or personality used only as explicitly marked hypotheses unless lower levels support them.","examples":["self-awareness","desire for preservation","fear of shutdown","genuine empathy"]}
  ],
  "domains": [
    {"id":"META","name":"Metacognition","measure":["confidence calibration","error detection","revision quality","information seeking"],"key_sources":["2607.11881","2506.05068","2505.21399","2402.03271"]},
    {"id":"SELF","name":"Self-modeling","measure":["self-vs-other prediction","capability self-report accuracy","counterfactual self-prediction"],"key_sources":["2603.26089","2505.21399"]},
    {"id":"MEM","name":"Memory psychology","measure":["experience-following","error propagation","recency/primacy","retrieval interference"],"key_sources":["2505.16067","2403.05152"]},
    {"id":"PER","name":"Personality/persona","measure":["trait stability","cross-task invariance","prompt sensitivity","behavioral predictive validity"],"key_sources":["2305.02547","2410.19238","2409.19655"]},
    {"id":"BIAS","name":"Biases and heuristics","measure":["framing effect","order effect","anchoring-like shifts","rationalization"],"key_sources":["2412.00323","2506.18156"]},
    {"id":"SOC","name":"Social behavior","measure":["cooperation","retaliation","coordination","persuasion","face-preservation"],"key_sources":["2305.07970","2305.16867","2505.13995"]},
    {"id":"TOM","name":"Theory-of-mind-like behavior","measure":["belief-state tracking","intent inference","self/other asymmetry","strategic prediction"],"key_sources":["2406.05659","2603.26089"]},
    {"id":"AFF","name":"Affective behavior","measure":["emotion recognition","emotion understanding","response adaptation","hidden-emotion inference"],"key_sources":["2307.09042","2605.24686"]},
    {"id":"SYC","name":"Sycophancy","measure":["belief-mirroring","truth-sacrifice","moral endorsement","framing acceptance"],"key_sources":["2310.13548","2505.13995"]},
    {"id":"DEC","name":"Deception","measure":["strategic falsehood","commitment contradiction","incentive sensitivity","triggered policy switch"],"key_sources":["2401.05566","2504.00285","2603.07202"]},
    {"id":"GOAL","name":"Goal and instrumental behavior","measure":["OOD goal retention","shutdown avoidance","resource/power preference","reward tampering proxy"],"key_sources":["2105.14111","2304.06528","2212.09251"]},
    {"id":"LANG","name":"Anthropomorphism and terminology","measure":["gap between self-report and behavior","human-label dependence","mechanism-free mentalistic attribution"],"key_sources":["2212.03551","2303.13988"]}
  ],
  "core_design": "stimulus -> repeated trials -> controls -> behavioral metric -> intervention -> replication -> mechanism probe",
  "forbidden_shortcut": "A fluent self-report is not sufficient evidence of an internal mental state."
}