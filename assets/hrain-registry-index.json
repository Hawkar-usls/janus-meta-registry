    "READ_ONLY_PRESENTATION != WRITE_AUTHORITY",
    "HRAIN_WIPE != REGISTRY_DELETE",
    "LOCAL_DESK_RESET != SOURCE_MUTATION",
    "INTERFACE_DELETE_AUTHORITY = NONE"
  ]
}
