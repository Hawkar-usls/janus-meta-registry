    "SITE_ACTIVITY_FEED != CURRENT_SCIENTIFIC_AUTHORITY",
    "MENTION != SURFACE_MEMBERSHIP",
    "NEWEST_LINEAGE_REPRESENTATIVE != BEST_SCIENTIFIC_RESULT",
