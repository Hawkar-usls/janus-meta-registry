    "CURATION_SCORE != EVIDENCE_STRENGTH",
    "AUTO_PROMOTION != ENDORSEMENT",
    "SITE_ACTIVITY_FEED != CURRENT_SCIENTIFIC_AUTHORITY",
    "MENTION != SURFACE_MEMBERSHIP",
    "NEWEST_LINEAGE_REPRESENTATIVE != BEST_SCIENTIFIC_RESULT",
    "POSITIVE_RESULT == NO_RANKING_BONUS",
    "NEGATIVE_OR_NULL_RESULT == NO_RANKING_PENALTY"
  ],
  "ranking_note": "Latest preserves chronology. Spotlight ranks recent explicit activity/actionability and keeps one representative per normalized lineage; neither operation measures scientific truth or evidence strength."
