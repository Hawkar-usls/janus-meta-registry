  ],
  "reviewer_bundle_contract": {
    "required_fields": [
      "reviewer_id",
      "attestation_id",
      "frozen_package_id",
      "verifier_status",
      "declared_independent",
      "labels_frozen_before_model_reveal",
      "labels"
    ],
    "minimum_reviewers_for_consensus": 2,
    "reviewer_ids_must_be_distinct": true,
    "attestation_ids_must_be_distinct": true,
    "frozen_package_id_must_match_collection": true,
    "verifier_status_required": "PASS",
    "declared_independence_required": true,
    "labels_frozen_before_model_reveal_required": true,
    "human_independence_proven_by_software": false
  },
  "consensus_rule": {
    "name": "EXACT_UNANIMITY_PER_FIELD",
    "all_reviewers_same": "PRESERVE_VALUE",
    "any_non_unanimity": "DISAGREEMENT",
    "majority_vote": false,
    "averaging": false,
    "model_fill": false,
    "silent_drop": false,
    "adjudication_in_v1": false
  },
  "hard_laws": [
    "DISAGREEMENT != ERROR",
    "DISAGREEMENT != MAJORITY_LOSS",
    "REVIEWER_COUNT != TRUTH_WEIGHT",
    "REVIEWER_ID != INDEPENDENCE_PROOF",
    "ATTESTATION != PERSONHOOD_PROOF",
    "UNANIMITY != OBJECTIVE_TRUTH",
    "WAITING != FAILURE",
    "MODEL_MAY_NOT_FILL_DISAGREEMENT",
    "REVIEW_COLLECTION != WORLD_AUTHORITY",
    "SYNTHETIC_REVIEWERS != REAL_HUMAN_EVIDENCE"
  ],
  "required_negative_tests": [
    "zero reviewers -> WAITING_FOR_FIRST_REVIEWER PASS",
    "one valid reviewer -> WAITING_FOR_SECOND_REVIEWER PASS",
    "two valid distinct reviewers on same frozen package -> READY_FOR_CONSENSUS",
    "duplicate reviewer ID -> INVALID_COLLECTION",
    "duplicate attestation ID -> INVALID_COLLECTION",
    "package mismatch -> INVALID_COLLECTION",
    "verifier failure -> INVALID_COLLECTION",
    "declared independence false -> INVALID_COLLECTION",
    "labels not frozen before model reveal -> INVALID_COLLECTION",
    "two unanimous field values -> unanimous value",
    "one field disagreement -> DISAGREEMENT",
    "three reviewers with 2-to-1 majority -> DISAGREEMENT",
    "review processing never changes authority or mass-effect budget"
  ],
  "portal_relationship": {
    "portal_may_route_review_request": true,
    "portal_may_create_consensus": false,
    "portal_may_override_disagreement": false,
    "rule": "PORTAL_ROUTE != REVIEW_CONSENSUS"
  },
  "claim_ceiling": {
    "allowed_after_L4": [
      "DemiHead can deterministically classify a frozen synthetic reviewer collection as waiting, ready, or invalid under explicit artifact rules.",
      "DemiHead can produce exact-unanimity per-field consensus while preserving any non-unanimity as DISAGREEMENT."
