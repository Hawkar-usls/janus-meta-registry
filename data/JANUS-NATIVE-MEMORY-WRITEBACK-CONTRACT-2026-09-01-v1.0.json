{
  "schema": "janus.native_model.memory_writeback_contract.v1",
  "artifact_id": "JANUS-NATIVE-MEMORY-WRITEBACK-CONTRACT-2026-09-01-v1.0",
  "date": "2026-09-01",
  "status": "CANONICAL_FAIL_CLOSED_WRITEBACK_CONTRACT",
  "purpose": "Allow the JANUS native model to create machine-readable JSON describing what it inferred while preventing raw model output from becoming truth, evidence, execution authority, or self-training material merely because it was written to the meta-registry.",
  "database_role": {
    "repository": "Hawkar-usls/janus-meta-registry",
    "role": "DURABLE_LONG_TERM_MEMORY_AND_TRAINING_DATABASE",
    "source_bearing_plane": "data/ and other EYE-admitted source files",
    "derived_non_authoritative_plane": "EYE/generated/native_model_reflections/"
  },
  "producer": {
    "repository": "Hawkar-usls/Janus-Demiurge",
    "path": "janus_model/outbox/reflection-*.json",
    "schema": "janus.model.reflection_proposal.v1",
    "required_status": "UNVERIFIED_MODEL_REFLECTION"
  },
  "bicameral_binding": {
    "formula": "HRAIN_GROUNDS -> EYE_BRIDGES -> INAIHR_ASSOCIATES -> HRAIN_MEDIATES -> VERIFY_DECIDES",
    "HRAiN": "STRUCTURAL_CONTEXT_GROUNDING_MEDIATOR",
    "iNaiHR": "ASSOCIATIVE_CONTEXT",
    "direct_eye_to_inaihr_bypass": false,
    "bicameral_agreement_is_truth": false,
    "terminal_authority": "VERIFY"
  },
  "writeback_transport": {
    "mode": "CREDENTIALLESS_PULL",
    "reader": "janus-meta-registry GitHub Actions",
    "source": "public Janus-Demiurge outbox",
    "destination": "EYE/generated/native_model_reflections/",
    "cross_repository_secret_required": false,
    "destination_write_authority": "janus-meta-registry workflow GITHUB_TOKEN only"
  },
  "raw_reflection_firewall": {
    "truth_authority": false,
    "evidence_authority": false,
    "execution_authority": false,
    "repository_mutation_authority": false,
    "eligible_for_training": false,
    "eligible_for_truth_promotion": false,
    "independent_verifier_required": true,
    "reason": "MODEL_OUTPUT != EVIDENCE and DERIVATIVE_SELF_OUTPUT != FRESH_SOURCE_EVIDENCE"
  },
  "promotion_lane": [
    "NATIVE_MODEL_OUTPUT",
    "UNVERIFIED_MODEL_REFLECTION_JSON",
    "PERSIST_IN_DERIVED_META_REGISTRY_MEMORY",
    "INDEPENDENT_VERIFY_OR_EXPLICIT_HUMAN_REVIEW",
    "IF_VERIFIED_CREATE_SEPARATE_SOURCE_BEARING_JSON_WITH_PROVENANCE",
    "ONLY_THEN_ELIGIBLE_FOR_FUTURE_EYE_AND_NATIVE_TRAINING"
  ],
  "required_reflection_provenance": [
    "workflow_run_id",
    "checkpoint_sha256",
    "meta_registry_source_commit",
    "meta_registry_source_digest",
    "organ_context_sha256",
    "hrain_commit",
    "inaihr_commit",
    "inference_sha256"
  ],
  "laws": [
    "META_REGISTRY_IS_MEMORY_DATABASE_NOT_AUTOMATIC_TRUTH",
    "RAW_MODEL_REFLECTION_MUST_NOT_REENTER_TRAINING",
    "HRAIN_GROUNDING != TRUTH",
    "INAIHR_ASSOCIATION != EVIDENCE",
    "BICAMERAL_AGREEMENT != INDEPENDENT_REPLICATION",
    "VERIFY_MUST_HAVE_POWER_TO_SAY_NO",
    "PROMOTION_CREATES_A_NEW_ARTIFACT; RAW_HISTORY_IS_NEVER_REWRITTEN"
  ],
  "seal": "JANUS MAY REMEMBER WHAT IT THOUGHT WITHOUT TEACHING ITSELF THAT ITS THOUGHT WAS TRUE."
}
