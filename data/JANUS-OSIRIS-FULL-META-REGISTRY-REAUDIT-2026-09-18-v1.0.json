  "reaudit_conclusions": [
    {
      "id": "CG53469_PROVENANCE_SUPERSESSION",
      "status": "CRITICAL_CORRECTION",
      "finding": "Current anti-loop state locks CG53469/JE35425 as a gold phallus sheath from Tell Ibn es-Salam / Mendes and places JE35425 inside the Engelbach 35420-42 site-level range. Older project states that bound CG53469 directly to the Nesbanebdjedet Tell el-Rub'a protected body-gold assemblage are superseded and must not be reused.",
      "implication": "The CG53469 sheath and the Tell el-Rub'a stamped-gold djed cannot presently be treated as a same-body pair. The djed passport/body-coordinate gate remains open."
    },
    {
      "id": "THREE_CATEGORY_RELIC_MODEL",
      "status": "STRONGEST_SYNTHESIS",
      "finding": "The corpus distinguishes (A) claimed geographical body relics, (B) deliberately manufactured ritual relic/substitute matter, and (C) physical ritual machinery used to manufacture/reassemble those substitutes.",
      "implication": "A text calling material a relic/member/body cannot establish biological identity until object passport, context and content classification pass."
    },
    {
      "id": "FOURTH_CONTROL_REAL_HUMAN_MEMBER",
      "status": "HIGH_VALUE_NEGATIVE_CONTROL",
      "finding": "Abydos Djer Tomb O supplies a real human-member control inside a monument later treated as an Osiris tomb, with surviving photo/textile/hair/bone proxies and C14 records.",
      "implication": "Even actual human tissue in an Osirian cult/reception context does not identify the tissue as Osiris."
    },
    {
      "id": "QH207_IS_DIFFERENT_MECHANISM",
      "status": "DISTINCT_PHYSICAL_PROCESS",
      "finding": "QH207 documents repair/re-membering of Osiris images using surviving bronze fragments plus wax/cast-on reconstruction. This must remain distinct from Dendera/Thonis/Coptos manufacture of ritual substitute bodies from barley, sand, earth and related ingredients.",
      "implication": "The broader Osirian material grammar has at least two physical operators: REPAIR_EXISTING_IMAGE and MANUFACTURE_SUBSTITUTE_BODY."
    },
    {
      "id": "EHNASYA_CONVERGENCE",
      "status": "PROMISING_OPEN_JOIN",
      "finding": "Heracleopolis combines textual multi-member reliquary traditions, a real 1956 local Osiris bronze cache, and archaeological Osiris-Naref evidence, but no source-bound join yet connects the cache to a relic chest/container or biological member.",
      "implication": "Context recovery for Kom Oshim Record 26 and object-level identifiers remains decisive."
    },
    {
      "id": "E11072_OXYRHYNCHUS_FUNCTION_MORPHOLOGY_SPLIT",
      "status": "ARCHIVAL_AND_COMPARATIVE_RESULT",
      "finding": "Louvre E11072 early documentation treats it as one mechanically joining part of a multipart assemblage; Oxyrhynchus supplies a fourfold protective/cardinal functional analogue but no known E11072-like morphology.",
      "implication": "Functional comparison is admissible; morphology/provenance transfer is not."
    },
    {
      "id": "QH207_GREEN_PATINA_BRANCH",
      "status": "NEGATIVE",
      "finding": "Source-bound expert correspondence states the present corrosion is not the original appearance; one QH207/40 fragment preserves gold leaf, other accessible fragments showed no further surface finishing.",
      "implication": "Intentional green-Osiris bronze coloration currently lacks support."
    },
    {
      "id": "LOST_CONTEXT_MECHANISM",
      "status": "METHODOLOGICAL_SYNTHESIS",
      "finding": "Across Mendes djed, QH207/32-38, E11072 and other lanes, object identity can survive while provenance, assembly relation or individual passport is flattened by grouped registration, transfer, renumbering or later catalogue compression.",
      "implication": "The search should prioritize archive joins and original registers rather than assuming missing context means missing object."
    }
  ],
