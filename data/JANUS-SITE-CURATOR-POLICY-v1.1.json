{
  "schema": "janus.site.autonomous_curator_policy.v1_1",
  "artifact_id": "JANUS-SITE-CURATOR-POLICY-v1.1",
  "status": "ACTIVE_DETERMINISTIC_PRESENTATION_POLICY",
  "supersedes": "data/JANUS-SITE-CURATOR-POLICY-v1.0.json",
  "change_reason": "The first live feed proved the autonomous pipeline but exposed cross-reference contamination: broad document content mentions could misroute general objects into AIFC, SCOBY or Linear A. v1.1 makes surface routing identity-first and keeps generic navigation objects out of Spotlight.",
  "purpose": "Automatically project recent and actionable public registry activity onto JANUS GitHub Pages without turning presentation rank into scientific authority.",
  "implementation": {
    "generator": "research/site/janus_site_curator.py",
    "renderer": "assets/site-curator.js",
    "presentation_css": "assets/site-curator.css",
    "generated_feed": "assets/site-feed.json",
    "automation": ".github/workflows/janus-site-autonomous-curator.yml"
  },
  "inputs": {
    "git_history": true,
    "public_paths": ["."],
    "extensions": [".json", ".md", ".py"],
    "lookback_commits": 320,
    "maximum_candidate_files": 260,
    "maximum_file_bytes_for_metadata": 524288
  },
  "outputs": {
    "generated_feed": "assets/site-feed.json",
    "latest_updates_count": 18,
    "spotlight_count": 8,
    "per_surface_count": 6,
    "spotlight_family_cap": 2
  },
  "routing": {
    "surface_match_scope": ["path", "extracted_title"],
    "full_content_mentions_may_route": false,
    "cross_reference_is_membership": false,
    "unmatched_surface": "other"
  },
  "surface_rules": [
    {"surface": "antifuck", "site_path": "antifuck/", "match_any": ["ANTIFUCK", "MINDFUCK", "ARMOR-OF-GOD", "OPIR_ANTIFUCK", "research/antifuck"]},
    {"surface": "linear-a", "site_path": "linear-a/", "match_any": ["LINEAR-A", "LINEAR_A", "LINEAR A", "research/linear_a"]},
    {"surface": "wedjat", "site_path": "wedjat/", "match_any": ["WEDJAT", "EYE-OF-HORUS", "EYE OF HORUS", "research/wedjat"]},
    {"surface": "scoby-skingpt", "site_path": "scoby-skingpt/", "match_any": ["SCOBY", "SKINGPT", "SKYBU"]},
    {"surface": "aifc", "site_path": "aifc/", "match_any": ["AIFC", "AUDITABLE-INDEPENDENT-FUTURE-CHALLENGE"]},
    {"surface": "fundamentum", "site_path": "fundamentum/", "match_any": ["FUNDAMENTUM", "P-N-JUNCTION", "P N JUNCTION", "research/fundamentum"]},
    {"surface": "gamarjoba-gen-ancvale", "site_path": "gamarjoba-gen-ancvale/", "match_any": ["GAMARJOBA", "GEN_ANCVALE", "GEN ANCVALE"]}
  ],
  "ranking": {
    "meaning": "activity_and_actionability_only",
    "signal_scope": ["path", "extracted_title", "extracted_status", "extracted_gate"],
    "full_content_mentions_may_score": false,
    "recency_points": [
      {"max_age_days": 0.25, "points": 56},
      {"max_age_days": 1, "points": 50},
      {"max_age_days": 2, "points": 45},
      {"max_age_days": 7, "points": 36},
      {"max_age_days": 30, "points": 24},
      {"max_age_days": 90, "points": 12},
      {"max_age_days": 36500, "points": 4}
    ],
    "signals": {
      "current_authority_or_state": {"points": 20, "tokens": ["CURRENT-AUTHORITY", "CURRENT_AUTHORITY", "CANONICAL-STATE", "CANONICAL_STATE", "RESEARCH-STATE", "RESEARCH_STATE", "CURRENT STATE"], "status_exact": ["CURRENT"]},
      "open_or_next_gate": {"points": 18, "gate_present": true, "tokens": ["NEXT_GATE", "NEXT REQUIRED GATE", "CURRENT_GATE", "AWAITING", "BLOCKED_UNTIL", "OPEN_GATE", "NOT_EXECUTED"]},
      "external_review_or_replication": {"points": 14, "tokens": ["EXTERNAL_REVIEW", "EXTERNAL REVIEW", "INDEPENDENT_REPLICATION", "INDEPENDENT REPLICATION", "REVIEWER", "REPLICATOR"]},
      "result_or_certificate": {"points": 14, "tokens": ["RESULT", "CERTIFICATE", "RECEIPT", "AUDIT"]},
      "invitation_or_contribution": {"points": 8, "tokens": ["INVITATION", "CONTRIBUTE", "CONTRIBUTOR", "GAMARJOBA"]}
    },
    "status_valence_used": false,
    "positive_result_bonus": 0,
    "negative_result_penalty": 0,
    "null_result_penalty": 0,
    "tie_breakers": ["score_desc", "modified_at_desc", "path_asc"]
  },
  "spotlight": {
    "eligible_path_prefixes": ["data/", "research/", "registry/", "docs/"],
    "exclude_exact_paths": ["data/INDEX.md"],
    "exclude_path_contains": [".example.", "/examples/", "/fixtures/"],
    "generic_root_navigation_is_spotlight_eligible": false
  },
  "exclusions": {
    "path_contains": [".github/", "assets/", "guestbook", "JANUS-SITE-CURATOR-POLICY", "JANUS-SEARCH-SURFACE", "research/site/janus_site_curator.py", "node_modules/", ".venv/", "__pycache__/"],
    "generated_objects_are_scientific_authority": false
  },
  "autonomy_boundary": {
    "may_discover_new_registry_objects": true,
    "may_refresh_latest_updates": true,
    "may_reorder_generated_spotlight": true,
    "may_group_objects_by_surface": true,
    "may_link_unclassified_new_work": true,
    "may_rewrite_scientific_source_objects": false,
    "may_raise_claim_ceiling": false,
    "may_hide_failed_or_null_results": false,
    "may_delete_history": false,
    "may_convert_rank_into_truth_claim": false,
    "may_replace_current_authority_json": false
  },
  "routing_canaries": [
    {"path": "README.md", "title": "JANUS Meta Registry", "expected_surface": "other"},
    {"path": "data/INDEX.md", "title": "data/INDEX — Evidence-first archive map", "expected_surface": "other"},
    {"path": "data/JANUS-GENESIS-GUARDIAN-MESH-KETO-CETUS-ECOSYSTEM-SWEEP-AND-CIVIC-RESILIENCE-v1.2.json", "title": "JANUS-GENESIS-GUARDIAN-MESH-KETO-CETUS-ECOSYSTEM-SWEEP-AND-CIVIC-RESILIENCE-v1.2", "expected_surface": "other"},
    {"path": "data/JANUS-ARMOR-OF-GOD-CURRENT-AUTHORITY.json", "title": "JANUS-ARMOR-OF-GOD-CURRENT-AUTHORITY", "expected_surface": "antifuck"},
    {"path": "data/JANUS-LINEAR-A-RESEARCH-STATE-2026-08-14-v2.4.json", "title": "JANUS Linear A Research State", "expected_surface": "linear-a"},
    {"path": "data/JANUS-WEDJAT-BLIND-HUMAN-ANNOTATION-READINESS-2026-08-16-v0.13.json", "title": "JANUS Wedjat", "expected_surface": "wedjat"},
    {"path": "data/JANUS-GENESIS-GUARDIAN-MESH-KETO-CETUS-DEMIHEAD-FINAL-CI-CERTIFICATE-2026-08-16-v1.3.2.json", "title": "JANUS Genesis Guardian Mesh DemiHead final CI certificate", "expected_surface": "other"}
  ],
  "claim_ceiling": [
    "FEATURED != SCIENTIFICALLY_TRUE",
    "RECENT != IMPORTANT",
    "CURATION_SCORE != EVIDENCE_STRENGTH",
    "AUTO_PROMOTION != ENDORSEMENT",
    "SITE_ACTIVITY_FEED != CURRENT_SCIENTIFIC_AUTHORITY",
    "MENTION != SURFACE_MEMBERSHIP",
    "POSITIVE_RESULT == NO_RANKING_BONUS",
    "NEGATIVE_OR_NULL_RESULT == NO_RANKING_PENALTY"
  ]
}
