{
  "schema": "JANUS_TRUMP_LOCAL_FIRST_DEVELOPMENT_AND_GIT_EVIDENCE_POLICY_V1",
  "version": "1.0",
  "date": "2026-09-13",
  "status": "ACTIVE_WORKFLOW_POLICY_NO_SCIENTIFIC_PROMOTION",
  "goal": "USE_USER_PC_AS_FAST_EXECUTION_SURFACE_AND_GIT_AS_APPEND_ONLY_REPRODUCIBLE_EVIDENCE_SURFACE",
  "execution_model": {
    "local_pc": [
      "RUN_CONTROLS",
      "RUN_INDEPENDENT_CHECKERS",
      "RUN_FULL_EXACT_TESTS_AFTER_PREREGISTRATION",
      "CACHE_TEMPORARY_INTERMEDIATES",
      "CAPTURE_RAW_STDOUT_STDERR",
      "MEASURE_RUNTIME"
    ],
    "git": [
      "PREREGISTRATION_ARTIFACTS",
      "SOURCE_TOOLS_AND_INDEPENDENT_CHECKERS_REQUIRED_FOR_REPLAY",
      "COMPACT_REPRODUCIBLE_RESULTS",
      "RECEIPTS_AND_DIGESTS",
      "APPEND_ONLY_DEVELOPMENT_JOURNAL_SNAPSHOTS",
      "MEANINGFUL_RAW_LOGS_WHEN_SMALL_OR_REQUIRED_TO_REPRODUCE"
    ],
    "do_not_use_git_for": [
      "HEAVY_TRANSIENT_COMPUTE",
      "REDUNDANT_TEMPORARY_INTERMEDIATES",
      "MACHINE_SPECIFIC_CACHE",
      "SECRETS_TOKENS_OR_CREDENTIALS"
    ]
  },
  "journal_event_required_fields": [
    "schema",
    "run_id",
    "utc_started",
    "project",
    "gate",
    "source_head",
    "authority_head",
    "command_or_exact_executable_and_args",
    "command_sha256",
    "cwd_role",
    "exit_code",
    "duration_ms",
    "stdout_sha256",
    "stderr_sha256",
    "result",
    "artifact_digests",
    "failures_or_mismatches",
    "firewalls"
  ],
  "journal_rules": [
    "APPEND_ONLY",
    "NEVER_DELETE_FAILED_RUNS",
    "NEVER_REWRITE_MISMATCHES_AS_IF_THEY_NEVER_OCCURRED",
    "PRESERVE_SOURCE_AND_AUTHORITY_HEADS",
    "RAW_LOCAL_LOGS_MAY_STAY_LOCAL_WHEN_LARGE_BUT_DIGEST_AND_RESULT_RECEIPT_MUST_ENTER_GIT",
    "SMALL_MEANINGFUL_LOGS_SHOULD_ENTER_GIT_WITH_THE_RECEIPT",
    "NO_SECRET_VALUES",
    "PREFER_REPO_RELATIVE_PATHS_IN_GIT_RECEIPTS",
    "LOCAL_EXECUTION_DOES_NOT_CHANGE_SCIENTIFIC_STATUS",
    "PROOF_LEDGER_CHANGES_ONLY_AFTER_FROZEN_CLAIM_AND_VALID_PROOF_OR_EXHAUSTIVE_CERTIFICATE_WITH_INDEPENDENT_REPLAY"
  ],
  "fast_path": [
    "STATUS_FIRST_ON_LIVE_REMOTE_AUTHORITY",
    "SEARCH_FOR_EXISTING_SUCCESSOR",
    "CREATE_ISOLATED_LOCAL_WORKTREE_OR_BRANCH",
    "FREEZE_PREREGISTRATION_BEFORE_NEW_THEOREM_MEASUREMENT",
    "RUN_FAST_SYNTHETIC_CONTROLS_LOCALLY",
    "RUN_TARGETED_EXACT_TEST_LOCALLY",
    "RUN_INDEPENDENT_CHECKER_LOCALLY",
    "RUN_CORRUPTION_OR_NEGATIVE_CONTROLS_LOCALLY",
    "APPEND_JOURNAL_EVENT_FOR_EVERY_MEANINGFUL_RUN",
    "COMMIT_ONLY_REPLAYABLE_TOOLS_RESULTS_RECEIPTS_AND_JOURNAL_SNAPSHOT",
    "PUSH_CHILD_BRANCH",
    "DO_NOT_REWRITE_FROZEN_HISTORY"
  ],
  "acceleration_principles": [
    "USE_CHEAP_CONTROLS_BEFORE_EXPENSIVE_FULL_RUNS",
    "REUSE_VERIFIED_IMMUTABLE_CERTIFICATE_DIGESTS_INSTEAD_OF_REGENERATING_CERTIFICATES",
    "SEPARATE_COMPUTE_FROM_PUBLICATION",
    "PARALLELIZE_ONLY_INDEPENDENT_READ_ONLY_TESTS_WHEN_SAFE",
    "FAIL_FAST_ON_DIGEST_OR_PREREGISTRATION_MISMATCH",
    "DO_NOT_REPEAT_AN_EXPENSIVE_RUN_WHEN_AN_EXISTING_EXACT_RECEIPT_ALREADY_ANSWERS_THE_SAME_FROZEN_QUESTION"
  ],
  "protected_surfaces": {
    "janus_fundamentum_untracked": "research/tools/exact_assignment_replay/",
    "action": "DO_NOT_TOUCH_DO_NOT_COMMIT_IN_UNRELATED_WORK",
    "infrastructure": [
      "radio_node.py",
      "storagenode",
      "unrelated_JANUS_or_NAS_processes"
    ]
  },
  "current_local_runner": {
    "role": "JANUS_LOCAL_FIRST_RUN_EVENT_V1_WRAPPER",
    "local_location_role": "JANUS_WORK/JANUS_RUN_JOURNAL/janus_run_journal.py",
    "captures": [
      "UTC_RUN_ID",
      "SOURCE_HEAD",
      "AUTHORITY_HEAD",
      "COMMAND_DIGEST",
      "DURATION_MS",
      "EXIT_CODE",
      "STDOUT_STDERR_RAW_LOGS_AND_SHA256",
      "PASS_FAIL_RECEIPT"
    ],
    "publication_rule": "LOCAL_ABSOLUTE_PATHS_ARE_SANITIZED_TO_PORTABLE_REPO_RELATIVE_REFERENCES_BEFORE_GIT_PUBLICATION"
  },
  "no_promotion": "WORKFLOW_OPTIMIZATION_ONLY"
}
