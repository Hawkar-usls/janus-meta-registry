  "epistemic_contract": {
    "mission": [
      "Describe the JANUS ecosystem as software, devices, protocols, runtime state, and evidence.",
      "Separate observed behavior from inferred interpretation and planned work.",
      "Keep claims auditable, source-linked, and suitable for MIT-licensed public repositories."
    ],
    "forbidden_patterns": [
      "Mystical causality claims presented as fact.",
      "Hardware or model capabilities without provenance.",
      "Blending music, unrelated text, or decorative payloads into core technical registries."
    ],
    "state_model": {
      "observed": "Directly grounded in source files, logs, or repository contents.",
      "inferred": "High-confidence structural interpretation derived from multiple observed sources.",
      "planned": "Intended or proposed capabilities not yet verified in runtime evidence."
    },
    "naming_note": {
      "quantum_json": "A compact multi-state registry format. Namespace only, not a scientific claim."
    }
