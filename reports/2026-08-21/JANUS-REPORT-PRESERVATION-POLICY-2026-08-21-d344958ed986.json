{
  "schema": "janus.meta_registry.report_preservation_policy.v1",
  "record_type": "report_preservation_policy",
  "policy_id": "JANUS-REPORT-PRESERVATION-POLICY-2026-08-21",
  "effective_date": "2026-08-21",
  "created_local": "2026-08-21T16:31:00+03:00",
  "created_utc": "2026-08-21T13:31:00Z",
  "repository": "Hawkar-usls/janus-meta-registry",
  "canonical_reports_root": "reports",
  "date_partition_pattern": "reports/YYYY-MM-DD/",
  "mandatory_rules": {
    "save_every_report_as_json": true,
    "include_report_date": true,
    "include_sha256": true,
    "filename_contains_date": true,
    "filename_contains_sha256_prefix": true,
    "preserve_claim_ceiling": true,
    "preserve_source_heads_when_known": true,
    "never_upgrade_hold_to_pass_without_witness": true
  },
  "integrity_method": {
    "algorithm": "SHA-256",
    "hash_scope": "canonical JSON payload excluding top-level integrity object",
    "canonicalization": "UTF-8; json.dumps(sort_keys=true,separators=(',',':'),ensure_ascii=false)",
    "filename_sha256_prefix_length": 12
  },
  "scope": {
    "applies_from": "2026-08-21",
    "applies_to": [
      "launch-gate reports",
      "research reports",
      "audit reports",
      "test reports",
      "experiment reports",
      "status reports",
      "integration reports",
      "external-evidence reports"
    ],
    "retroactive_backfill": "NOT_IMPLIED; existing reports remain preserved in place unless explicitly migrated"
  },
  "source_registry_main_at_policy_creation": "63674b5297d1711e3e73a593aace96e4e0bbc3f9",
  "integrity": {
    "algorithm": "SHA-256",
    "canonical_payload_sha256": "d344958ed98602d18fdb0dc33f74f1e7f23fb6e42dd8789057e6e79933ff9fbd",
    "verification_scope": "all top-level fields except integrity"
  }
}
