{
  "schema": "JANUS/THE_MAGIC_KEY/v1.0",
  "schema_id": "janus.the_magic_key.v1",
  "registry_id": "JANUS-THE-MAGIC-KEY-JSON-META-PROPERTIES-2026-08-30-v1.0",
  "title": "The Magic Key",
  "status": "RESEARCH_BRANCH_ACTIVE_HYPOTHESES_UNCONFIRMED",
  "date": "2026-08-30",
  "repository": "Hawkar-usls/janus-meta-registry",
  "branch": "research/the-magic-key-json-meta-2026-08-30",
  "base_commit": "ecd2397bdfb11165b35b0c6cd9d82e93344f7d16",
  "mission": "Study JSON not merely as serialization, but as a constrained meta-object whose structure can simultaneously carry data, schema cues, provenance, graph relations, falsifiable tests and a declarative algorithm/state machine.",
  "known_json_properties_not_claimed_new": [
    "hierarchical objects/arrays/scalars",
    "deterministic canonicalization is possible under a frozen profile",
    "schemas can validate JSON",
    "JSON can encode graphs, state machines and declarative programs",
    "hashes can bind canonical byte representations"
  ],
  "research_focus": [
    "constraint-defined identity",
    "data↔schema role duality",
    "JSON↔graph reversible projection",
    "minimal distinguishing subgraph as MAGIC_KEY",
    "semantic collision measurement",
    "nested observer/subject relations",
    "provenance/evidence chains",
    "structural activation gates",
    "self-description without self-execution"
  ],
  "self_description": {
    "artifact_roles": [
      "dataset",
      "schema_declaration",
      "research_program",
      "state_machine_specification",
      "provenance_record"
    ],
    "self_path": "research/the_magic_key/the_magic_key.v1.json",
    "canonical_profile": "sorted keys; compact UTF-8; reject duplicate object keys; normalize only according to the frozen experiment profile",
    "authority": "NON_EXECUTABLE_DATA",
    "requires_external_interpreter": true
  },
  "constraint_graph_seed": {
    "source": "user-provided Trinity relation diagram; used only as a structural constraint example",
    "nodes": [
      {"id": "FATHER", "type": "PERSON"},
      {"id": "SON", "type": "PERSON"},
      {"id": "SPIRIT", "type": "PERSON"},
      {"id": "GOD", "type": "ESSENCE"}
    ],
    "edges": [
      {"s": "FATHER", "p": "IS", "o": "GOD", "polarity": "POSITIVE"},
      {"s": "SON", "p": "IS", "o": "GOD", "polarity": "POSITIVE"},
      {"s": "SPIRIT", "p": "IS", "o": "GOD", "polarity": "POSITIVE"},
      {"s": "FATHER", "p": "IS", "o": "SON", "polarity": "NEGATIVE"},
      {"s": "FATHER", "p": "IS", "o": "SPIRIT", "polarity": "NEGATIVE"},
      {"s": "SON", "p": "IS", "o": "SPIRIT", "polarity": "NEGATIVE"}
    ],
    "lesson": "The information content lies in the whole relation pattern. Positive identity edges alone collapse distinctions; negative edges alone lose the shared relation."
  },
  "embedded_algorithm": {
    "name": "MAGIC_KEY_META_LOOP",
    "derivation": "JANUS search grammar + representation grammar + interface grammar, with TOPA/Spider discovery and Pippi/Keymaster/M2R-style candidate selection adapted to representation hypotheses",
    "mode": "DECLARATIVE_ONLY",
    "op_vocabulary": [
      "select",
      "project",
      "canonicalize",
      "hash",
      "compare",
      "assert",
      "emit",
      "transition",
      "freeze",
      "score"
    ],
    "forbidden_ops": [
      "shell",
      "eval",
      "exec",
      "dynamic_import",
      "secret_access",
      "arbitrary_network",
      "arbitrary_file_write"
    ],
    "states": [
      "SEED",
      "DISCOVER_PRIOR_ART",
      "FREEZE_PROFILE",
      "CANONICALIZE",
      "PROJECT_GRAPH",
      "GENERATE_MAGIC_KEYS",
      "FALSIFY",
      "REVERSE_PROJECT",
      "SCORE",
      "FREEZE_RESULT"
    ],
    "transitions": [
      {"from": "SEED", "to": "DISCOVER_PRIOR_ART", "guard": "seed_present"},
      {"from": "DISCOVER_PRIOR_ART", "to": "FREEZE_PROFILE", "guard": "internal_prior_art_map_saved"},
      {"from": "FREEZE_PROFILE", "to": "CANONICALIZE", "guard": "benchmark_and_semantics_frozen"},
      {"from": "CANONICALIZE", "to": "PROJECT_GRAPH", "guard": "canonicalization_selftests_pass"},
      {"from": "PROJECT_GRAPH", "to": "GENERATE_MAGIC_KEYS", "guard": "graph_projection_valid"},
      {"from": "GENERATE_MAGIC_KEYS", "to": "FALSIFY", "guard": "candidate_key_set_nonempty"},
      {"from": "FALSIFY", "to": "REVERSE_PROJECT", "guard": "counterexamples_preserved"},
      {"from": "REVERSE_PROJECT", "to": "SCORE", "guard": "round_trip_receipt_exists"},
      {"from": "SCORE", "to": "FREEZE_RESULT", "guard": "holdout_complete"}
    ],
    "scoring": {
      "objectives": [
        "discrimination",
        "stability",
        "reversibility",
        "compactness",
        "auditability"
      ],
      "anti_objectives": [
        "post_hoc_retuning",
        "authority_leakage",
        "parser_dependence",
        "semantic_collision"
      ],
      "fingerprint_rule": "fingerprint may rank candidate keys but is never identity or truth"
    }
  },
  "activation_model": {
    "default_state": "LOCKED",
    "armed_when": [
      "schema_valid",
      "duplicate_keys_absent",
      "canonical_profile_pass",
      "required_positive_constraints_satisfied",
      "required_negative_constraints_satisfied",
      "interpreter_capability_set_allowlisted"
    ],
    "meaning_of_armed": "external interpreter may evaluate allowlisted declarative operations; JSON itself never executes",
    "fail_closed": true
  },
  "provenance": {
    "seed_date": "2026-08-30",
    "base_registry_commit": "ecd2397bdfb11165b35b0c6cd9d82e93344f7d16",
    "internal_prior_art_file": "research/the_magic_key/topa_spider_prior_art_map.v1.json",
    "hypotheses_file": "research/the_magic_key/meta_properties_hypotheses.v1.json",
    "experiments_file": "research/the_magic_key/experiments.v1.json"
  },
  "integrity_laws": [
    "HASH != TRUTH",
    "CANONICAL_EQUIVALENCE != SEMANTIC_IDENTITY_UNLESS_PROFILE_SAYS_SO",
    "FINGERPRINT != IDENTITY",
    "JSON_CONTENT != EXECUTABLE_COMMAND",
    "CAPABILITY != AUTHORITY",
    "ASSOCIATION != PROOF",
    "NOVEL_COMBINATION != NOVEL_DISCOVERY",
    "NEGATIVE_RESULT_IS_DATA"
  ],
  "next_gate": "Run E1/E6/E7 first, then compute a first exact MAGIC_KEY on a small frozen universe. Only after internal tests pass should TOPA/Spider perform an external prior-art sweep over JSON Schema, JSON-LD/RDF, canonical JSON/JCS, declarative rule languages and graph serialization literature."
}
